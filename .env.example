# FORGE Mining Engine — environment configuration template.
# Copy to .env and fill in. NEVER commit real secrets (rule: no secrets in code).

# Database connection (PostgreSQL). The dev helper scripts/pg_dev.sh prints a
# matching URL for a throwaway local cluster.
FORGE_DATABASE_URL=postgresql+psycopg2://postgres@/forge?host=/tmp&port=5433

# Paths to externalised configuration (config, not code).
FORGE_DORMANCY_CONFIG=config/dormancy.yaml
FORGE_SCORING_CONFIG=config/scoring.yaml

# LLM provider (provider-agnostic wrapper; EU-hosting preferred). Used in later
# slices — keep keys here, never in source.
# FORGE_LLM_PROVIDER=
# FORGE_LLM_API_KEY=
# FORGE_LLM_REGION=
